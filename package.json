{
  "name": "@ianalloway/kelly-js",
  "version": "1.0.1",
  "description": "Tree-shakeable TypeScript toolkit for Kelly Criterion, CLV, EV, bankroll stats, odds conversion, line shopping, and hedge sizing \u2014 zero runtime dependencies.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:dist": "npm run build && node scripts/verify-dist.cjs",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run lint && npm run test && npm run test:dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "kelly",
    "kelly-criterion",
    "sports-betting",
    "bankroll",
    "clv",
    "expected-value",
    "odds-conversion",
    "line-shopping",
    "parlay",
    "hedge",
    "monte-carlo",
    "typescript",
    "gambling"
  ],
  "author": "Ian Alloway <ian@allowayllc.com>",
  "license": "MIT",
  "homepage": "https://github.com/ianalloway/kelly-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ianalloway/kelly-js.git"
  },
  "bugs": {
    "url": "https://github.com/ianalloway/kelly-js/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
